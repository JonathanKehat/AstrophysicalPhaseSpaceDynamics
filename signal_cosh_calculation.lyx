\begin_layout Section*
Back of the envelope calculation
\end_layout

\begin_layout Standard
First we define the fraction of dark matter of the PBH as 
\begin_inset Formula $f_{pbh}$
\end_inset

,
 and get the number density of PBHs:
\begin_inset Formula 
\[
n=\frac{f_{pbh}\rho_{dm}}{M}
\]

\end_inset


\end_layout

\begin_layout Standard
where 
\begin_inset Formula $\rho_{DM}$
\end_inset

 is the dark matter density and 
\begin_inset Formula $M$
\end_inset

 is the mass of the black hole.
 
\end_layout

\begin_layout Standard
then the distance between black holes should be :
 
\begin_inset Formula 
\[
d\sim n^{-1/3}=\left(\frac{M}{f_{pbh}\rho_{dm}}\right)
\]

\end_inset

 Adopting the value for 
\begin_inset Formula $\rho_{dm}\approx0.0083M_{\odot}/\text{pc}^{3}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
d\approx4.94\left(\frac{M}{M_{\odot}}\right)^{1/3}f_{pbh}^{-1/3}\left(\frac{\rho_{dm}}{0.0083M_{\odot}/\text{pc}^{3}}\right)^{-1/3}
\]

\end_inset


\end_layout


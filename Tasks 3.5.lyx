\begin_layout Section*
Test 2 - Adding a time dependent potential 
\end_layout

\begin_layout Subsection*
Test 2a Adding a satellite
\end_layout

\begin_layout Standard
The new potential is:
\begin_inset Formula 
\[
\Phi(z)=\Phi(z)+\alpha\delta\Phi_{}(z)*\Theta(t_{end}-t_{start})
\]

\end_inset


\end_layout

\begin_layout Subsection*

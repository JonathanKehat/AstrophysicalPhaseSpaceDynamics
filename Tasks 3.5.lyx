\begin_layout Section*
Elliptic Shape Explanation
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\Phi=2\pi G\rho_{DM}h_{DM}^{2}\ln\cosh\left(\frac{z}{h_{DM}}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
since 
\begin_inset Formula $z<<h_{DM}$
\end_inset

 for:
\begin_inset Formula 
\[
\ln\left(\cosh\left(\frac{z}{h_{DM}}\right)\right)\approx\ln\left(1+\left(\frac{z}{h_{DM}}\right)^{2}\right)\approx\left(\frac{z}{h_{DM}}\right)^{2}
\]

\end_inset

 so what we get is :
\begin_inset Formula 
\[
\Phi=2\pi G\rho_{DM}z^{2}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\mathrm{NLL}(\nu);\approx;\mathrm{NLL}(\nu_{t});+;\underbrace{\mathrm{NLL}'(\nu_{t})}{=,g},(\nu-\nu_{t});+;\tfrac{1}{2}\underbrace{\mathrm{NLL}''(\nu_{t})}{=,k},(\nu-\nu_{t})^{2}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{d,\mathrm{NLL}}{d\nu};\approx;g;+;k,(\nu-\nu_{t})
\]

\end_inset


\end_layout

\begin_layout Section*
Tasks
\end_layout

\begin_layout Standard
1.
 Understand the assymetry between Z and W in the missmatch fitting.
 
\end_layout

\begin_layout Standard
2.
 Continue to the part where we add a simple time dependent gravitational potential.
\end_layout

\begin_layout Section*
Mismatch Fitted 
\begin_inset Formula $\sigma_{z}$
\end_inset

 and 
\begin_inset Formula $\sigma_{w}$
\end_inset


\end_layout

\begin_layout Subsection*
Harmonic Regime
\end_layout

\begin_layout Standard
we have 
\begin_inset Formula $\Phi(z)=\frac{1}{2}\nu^{2}z^{2}$
\end_inset

 and 
\begin_inset Formula $H(z,w)=\frac{1}{2}w^{2}+\frac{1}{2}\nu^{2}z^{2}$
\end_inset


\end_layout

\begin_layout Standard
Hamilton equations:
\begin_inset Formula 
\[
\dot{z}=\frac{∂H}{∂w};\dot{w}=-\frac{∂H}{∂z}
\]

\end_inset


\end_layout

\begin_layout Standard
This is a simple harmonic oscillator with the solution:
\begin_inset Formula 
\[
\left(\begin{array}{c}
z(t)\\
w(t)
\end{array}\right)=\left(\begin{array}{cc}
\cos(\nu t) & \frac{1}{\nu}\sin(\nu t)\\
-\nu\sin(\nu t) & \cos(\nu t)
\end{array}\right)\left(\begin{array}{c}
z_{0}\\
w_{0}
\end{array}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
taking the inverse gives:
\begin_inset Formula 
\[
\left(\begin{array}{c}
z_{0}\\
w_{0}
\end{array}\right)=\left(\begin{array}{cc}
\cos(\nu t) & -\frac{1}{\nu}\sin(\nu t)\\
\nu\sin(\nu t) & \cos(\nu t)
\end{array}\right)\left(\begin{array}{c}
z(t)\\
w(t)
\end{array}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
This is the analytic solution,
 for a set of data 
\begin_inset Formula $\left\{ z_{obs},w_{obs}\right\} $
\end_inset

 it is right in particular and depend on 
\begin_inset Formula $\nu$
\end_inset

 (where the free parameter is):
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\left(\begin{array}{c}
z_{0}(\nu)\\
w_{0}(\nu)
\end{array}\right)=\left(\begin{array}{cc}
\cos(\nu t) & -\frac{1}{\nu}\sin(\nu t)\\
\nu\sin(\nu t) & \cos(\nu t)
\end{array}\right)\left(\begin{array}{c}
z_{obs}\\
w_{obs}
\end{array}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
The data sees the truth sets of 
\begin_inset Formula $\left\{ z_{obs}^{i},w_{obs}^{i}\right\} $
\end_inset

 which depends on the sampled 
\begin_inset Formula $\left\{ z_{0}^{i},w_{0}^{i}\right\} $
\end_inset

 so in order to understand statistically the log likelihood behavior we need to connect the back integration equations to the sampled phase space.
 
\end_layout

\begin_layout Standard
For that we need to place the true 
\begin_inset Formula $\left\{ z_{obs}^{i},w_{obs}^{i}\right\} $
\end_inset

 dependence on 
\begin_inset Formula $\left\{ z_{0}^{i},w_{0}^{i}\right\} $
\end_inset

:
\begin_inset Formula 
\[
\left(\begin{array}{c}
z_{obs}^{i}\\
w_{obs}^{i}
\end{array}\right)=\left(\begin{array}{cc}
\cos(\nu_{t}t) & \frac{1}{\nu_{t}}\sin(\nu_{t}t)\\
-\nu_{t}\sin(\nu_{t}t) & \cos(\nu_{t}t)
\end{array}\right)\left(\begin{array}{c}
z_{0}^{i}\\
w_{0}^{i}
\end{array}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
where 
\begin_inset Formula $\nu_{t}$
\end_inset

 is the true free parameter of the data.
 
\end_layout

\begin_layout Standard
plugging this into the general dependence of 
\begin_inset Formula $z_{0}(\nu),w_{0}(\nu)$
\end_inset

 we get:
\begin_inset Formula 
\begin{align*}
\left(\begin{array}{c}
z_{0}(\nu)\\
w_{0}(\nu)
\end{array}\right) & =\left(\begin{array}{cc}
\cos(\nu t) & -\frac{1}{\nu}\sin(\nu t)\\
\nu\sin(\nu t) & \cos(\nu t)
\end{array}\right)\left(\begin{array}{cc}
\cos(\nu_{t}t) & \frac{1}{\nu_{t}}\sin(\nu_{t}t)\\
-\nu_{t}\sin(\nu_{t}t) & \cos(\nu_{t}t)
\end{array}\right)\left(\begin{array}{c}
z_{0}^{i}\\
w_{0}^{i}
\end{array}\right)\\
 & =\left(\begin{array}{cc}
A(\nu) & C(\nu)\\
B(\nu) & D(\nu)
\end{array}\right)\left(\begin{array}{c}
z_{0}^{i}\\
w_{0}^{i}
\end{array}\right)
\end{align*}

\end_inset

Where:
\begin_inset Formula 
\begin{align*}
A(\nu) & =\cos\theta_{t}\cos\theta+\frac{\nu_{t}}{\nu}\sin\theta_{t}\sin\theta\\
B(\nu) & =\frac{1}{\nu_{t}}\sin\theta_{t}\cos\theta-\frac{1}{\nu}\cos\theta_{t}\sin\theta\\
C(\nu) & =\nu\cos\theta_{t}\sin\theta-\nu_{t}\sin\theta_{t}\cos\theta\\
D(\nu) & =\frac{\nu}{\nu_{t}}\sin\theta_{t}\sin\theta+\cos\theta_{t}\cos\theta
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
The NLL(Negative log likelihood) is:
\begin_inset Formula 
\[
\text{NLL}(\nu)=\frac{\langle z_{0}(\nu)^{2}\rangle}{2\sigma_{z,\text{fit}}^{2}}+\frac{\langle w_{0}(\nu)^{2}\rangle}{2\sigma_{w,\text{fit}}^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
In the harmonic case we can write the explicit dependence :
\begin_inset Formula 
\begin{align*}
\langle z_{0}(\nu)^{2}\rangle & =A^{2}(\nu)\langle\left(z_{0}^{i}\right)^{2}\rangle+\underbrace{A(\nu)C(\nu)\langle z_{0}^{i}\rangle\langle w_{0}^{i}\rangle}_{0}+C^{2}(\nu)\langle\left(w_{0}^{i}\right)^{2}\rangle=\\
 & =\left(\sigma_{z}^{true}\right)^{2}A^{2}(\nu)+\left(\sigma_{w}^{true}\right)^{2}C^{2}(\nu)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\langle w_{0}(\nu)^{2}\rangle=\left(\sigma_{z}^{true}\right)^{2}B^{2}(\nu)+\left(\sigma_{w}^{true}\right)^{2}D^{2}(\nu)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\text{NLL}(\nu)=\frac{\left(\sigma_{z}^{true}\right)^{2}A^{2}(\nu)+\left(\sigma_{w}^{true}\right)^{2}C^{2}(\nu)}{2\left(\sigma_{z}^{\text{fit}}\right)^{2}}+\frac{\left(\sigma_{z}^{true}\right)^{2}B^{2}(\nu)+\left(\sigma_{w}^{true}\right)^{2}D^{2}(\nu)}{2\left(\sigma_{w}^{\text{fit}}\right)^{2}}\equiv\frac{V_{z}}{2\left(\sigma_{z}^{\text{fit}}\right)^{2}}+\frac{V_{w}}{2\left(\sigma_{w}^{\text{fit}}\right)^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
So we know how the likelihood changes when we mismatch 
\begin_inset Formula $\sigma_{z}^{\text{fit}},\sigma_{w}^{\text{fit}}$
\end_inset

 and 
\begin_inset Formula $\sigma_{z}^{\text{true}},\sigma_{w}^{\text{true}}$
\end_inset

.
 
\end_layout

\begin_layout Subsubsection*
The NLL relation to the fitted parameter 
\begin_inset Formula $\nu$
\end_inset


\end_layout

\begin_layout Standard
expanding the NLL around the minimum 
\begin_inset Formula $\nu=\nu_{t}$
\end_inset

 gives:
 
\begin_inset Formula 
\[
\text{NLL}(\nu_{t}+t)=\text{NLL}(\nu_{t})+\text{NLL}'(\nu_{t})t+\text{NLL}''(\nu_{t})t^{2}
\]

\end_inset


\end_layout

\begin_layout Standard
when you look for the minimum :
\begin_inset Formula 
\begin{align*}
\frac{d}{dt}\text{NLL} & =\text{NLL}'(\nu_{t})+\text{NLL}''(\nu_{t})t=0\\
t & =-\frac{\text{NLL}'(\nu_{t})}{\text{NLL}''(\nu_{t})}=\nu_{t}-\nu=\delta\nu
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
This is the definition of a newton step optimization which in our simulation will be the change in the fitted parameter 
\begin_inset Formula $\nu(h_{DM})$
\end_inset

.
 In a parabola the newton step is the distance from the minimum :
\end_layout

\begin_layout Standard
in our case this is approximately correct.
 
\end_layout

\begin_layout Standard
we can calculate that exactly when we mismatch the STDEV of the fitted pdf.
\end_layout

\begin_layout Standard
Example for a parabola :
\begin_inset Formula 
\[
f(x)=3x^{2}+6x+8
\]

\end_inset


\end_layout

\begin_layout Standard
The minimum is :
\begin_inset Formula 
\begin{align*}
f'(x) & =6x+6=0\\
x_{min} & =-1
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
when we expand near 
\begin_inset Formula $x=2$
\end_inset

 we get:
\begin_inset Formula 
\[
t=-\frac{18}{6}=-3
\]

\end_inset


\end_layout

\begin_layout Standard
so the minimum is exactly at:
\begin_inset Formula 
\[
x_{min}=x_{expand}+t=-1
\]

\end_inset


\end_layout

\begin_layout Subsubsection*
First Derivative of NLL
\end_layout

\begin_layout Standard
Diffrentiating A B C and D:
\begin_inset Formula 
\begin{align*}
A' & =-\frac{sin^{2}\theta_{t}}{\nu_{t}}\\
C' & =-\frac{t}{\nu_{t}}+\frac{sin2\theta_{t}}{2\nu_{t}^{2}}\\
B' & =\nu_{t}t+\frac{\sin2\theta_{t}}{2}\\
D' & =\frac{\sin^{2}\theta_{t}}{\nu_{t}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
So the likelihood is :
\begin_inset Formula 
\begin{align*}
\text{NLL}' & =\frac{V_{z}'}{2\left(\sigma_{z}^{\text{fit}}\right)^{2}}+\frac{V_{w}'}{2\left(\sigma_{w}^{\text{fit}}\right)^{2}}=\\
 & =-\frac{\left(\sigma_{z}^{true}\right)^{2}\sin^{2}\theta_{t}}{\nu_{t}\left(\sigma_{z}^{\text{fit}}\right)^{2}}+\frac{\left(\sigma_{w}^{true}\right)^{2}\sin^{2}\theta_{t}}{\nu_{t}\left(\sigma_{w}^{\text{fit}}\right)^{2}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
we can see that if 
\begin_inset Formula $\sigma_{z}^{true}=\sigma_{z}^{fit}$
\end_inset

 and 
\begin_inset Formula $\sigma_{w}^{true}=\sigma_{w}^{fit}$
\end_inset

 we get the minimum.
\end_layout

\begin_layout Subsubsection*
Second Derivative of NLL
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
V''_{z}(\nu_{t}) & =2\left(\sigma_{z}^{true}\right)^{2}\left[(A')^{2}+AA''\right]|_{\nu_{t}}+2\left(\sigma_{w}^{true}\right)^{2}\left[(C')^{2}+CC''\right]|_{\nu_{t}}\\
V''_{w}(\nu_{t}) & =2\left(\sigma_{z}^{true}\right)^{2}\left[(B')^{2}+BB''\right]|_{\nu_{t}}+2\left(\sigma_{w}^{true}\right)^{2}\left[(D')^{2}+DD''\right]|_{\nu_{t}}
\end{align*}

\end_inset

Second derivatives for A and D are the important ones:
\begin_inset Formula 
\[
A''(\nu_{t})\approx-t^{2}+O(t);D''(\nu_{t})\approx-t^{2}+O(t)
\]

\end_inset

 for C and B the important conributions are from 
\begin_inset Formula $C'^{2},B'^{2}$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\left(C'(\nu_{t})\right)^{2}\approx-\frac{t^{2}}{\nu_{t}^{2}}+O(t);\left(B'(\nu_{t})\right)^{2}\approx-\nu_{t}^{2}t^{2}+O(t)
\]

\end_inset


\end_layout

\begin_layout Standard
so the second derivative of the components of 
\begin_inset Formula $\text{NLL}$
\end_inset

:
\begin_inset Formula 
\begin{align*}
V_{z}''(\nu_{t}) & \approx2t^{2}\left(\left(\frac{\sigma_{w}^{true}}{\nu_{t}}\right)^{2}-\left(\sigma_{z}^{true}\right)^{2}\right)\\
V_{w}''(\nu_{t}) & \approx2t^{2}\left(\left(\sigma_{z}^{true}\nu_{t}\right)^{2}-\left(\sigma_{w}^{true}\right)^{2}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Now we define two important parameters that dictates the behavior of the simulation.
 
\end_layout

\begin_layout Standard
1.
 the dimensionless mismatch ratio:
\begin_inset Formula 
\[
R\equiv\frac{\sigma_{w}^{\text{true}}}{\nu_{t}\sigma_{z}^{\text{true}}}
\]

\end_inset


\end_layout

\begin_layout Standard
this is a property of the simulation that dictates the fit behavior.
\end_layout

\begin_layout Standard
The second derivative could be expressed with 
\begin_inset Formula $R^{2}$
\end_inset

:
\begin_inset Formula 
\begin{align*}
V_{z}''(\nu_{t}) & =2\left(\sigma_{z}^{\text{true}}\right)^{2}t^{2}\left(R^{2}-1\right)\\
V_{w}''(\nu_{t}) & =2\left(\sigma_{w}^{\text{true}}\right)^{2}t^{2}\left(1/R^{2}-1\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
2.
 the mismatch for the fit and show how it changes between the position and momentum:
 
\begin_inset Formula $r=\frac{\sigma_{i}^{\text{true}}}{\sigma_{i}^{\text{fit}}}$
\end_inset

,
 where 
\begin_inset Formula $i=z,w$
\end_inset

.
 
\end_layout

\begin_layout Subsection*
Mismatching 
\begin_inset Formula $\sigma_{z}$
\end_inset

 - 
\begin_inset Formula $r=\frac{\sigma_{z}^{\text{true}}}{\sigma_{z}^{\text{fit}}},$
\end_inset


\begin_inset Formula $\sigma_{w}^{\text{true}}=\sigma_{w}^{\text{fit}}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\text{NLL}'(\nu_{t}) & =\frac{V'(\nu_{t})}{\left(\sigma_{w}^{\text{fit}}\right)^{2}}+r^{2}\frac{V'(\nu_{t})}{\left(\sigma_{z}^{\text{fit}}\right)^{2}}=-\frac{2\sin^{2}\theta_{t}}{\nu_{t}}(r^{2}-1)\\
\text{NLL}''(\nu_{t}) & =\frac{V''(\nu_{t})}{\left(\sigma_{w}^{\text{fit}}\right)^{2}}+r^{2}\frac{V''(\nu_{t})}{\left(\sigma_{z}^{\text{fit}}\right)^{2}}\approx2t^{2}R^{2}r^{2}-2t^{2}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
so the mismatch in z causes the shift of the fitted parameter by:
\begin_inset Formula 
\[
\delta\nu_{z}\approx\frac{\sin^{2}\theta_{t}(r^{2}-1)}{\nu_{t}t^{2}(R^{2}r^{2}-1)}
\]

\end_inset


\end_layout

\begin_layout Subsection*
Mismatching 
\begin_inset Formula $\sigma_{w}$
\end_inset

 - 
\begin_inset Formula $r=\frac{\sigma_{w}^{\text{true}}}{\sigma_{w}^{\text{fit}}},$
\end_inset


\begin_inset Formula $\sigma_{z}^{\text{true}}=\sigma_{z}^{\text{fit}}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\text{NLL}'(\nu_{t}) & =\frac{V'(\nu_{t})}{\left(\sigma_{w}^{\text{fit}}\right)^{2}}+r^{2}\frac{V'(\nu_{t})}{\left(\sigma_{z}^{\text{fit}}\right)^{2}}=\frac{2\sin^{2}\theta_{t}}{\nu_{t}}(r^{2}-1)\\
\text{NLL}''(\nu_{t}) & =\frac{V''(\nu_{t})}{\left(\sigma_{w}^{\text{fit}}\right)^{2}}+r^{2}\frac{V''(\nu_{t})}{\left(\sigma_{z}^{\text{fit}}\right)^{2}}\approx2t^{2}R^{2}-2t^{2}r^{2}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
so the mismatch in z causes the shift of the fitted parameter by:
\begin_inset Formula 
\[
\delta\nu_{w}\approx\frac{\sin^{2}\theta_{t}(r^{2}-1)}{\nu_{t}t^{2}(R^{2}-r^{2})}
\]

\end_inset

 
\end_layout

\begin_layout Standard
So the asymmetry is:
\begin_inset Formula 
\[
\frac{\delta\nu_{w}}{\delta\nu_{z}}=\frac{(\cancel{t^{2}}R^{2}r^{2}-\cancel{t^{2}})}{(\cancel{t^{2}}R^{2}-\cancel{t^{2}}r^{2})}=\frac{R^{2}r^{2}-1}{R^{2}-r^{2}}
\]

\end_inset

 
